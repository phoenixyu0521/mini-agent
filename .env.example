# 把这个文件复制成 .env，然后填入你自己的值。
# .env 已被 .gitignore 忽略，不会进 Git —— 所以 Key 只留在你本机。
#
# Windows 复制命令（PyCharm 内置 Terminal / CMD / PowerShell）：
#   copy .env.example .env
#
# 默认配的是智谱的免费模型，不花钱。想换 DeepSeek 见文件末尾。

# ---- 模型接口 ----
# OpenAI 兼容接口的地址。换服务商时只改这一行。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 你的 API Key。注意：这里填的是示例值，必须替换。
# 智谱 Key 申请页：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
LLM_API_KEY=请替换成你自己的Key

# ---- 模型与请求参数 ----
# 智谱当前永久免费的文本模型（2026-09 官方定价页核实）：glm-4.7-flash，200K 上下文
LLM_MODEL_ID=glm-4.7-flash

# 单次请求最多生成多少 token。这是「成本上限」，必须设。
LLM_MAX_TOKENS=1024

# 请求超时（秒）。这是「时间上限」，必须设。
LLM_TIMEOUT=30

# ---- 想换 DeepSeek：把上面三行换成下面三行 ----
# 警告：deepseek-chat 这个名字已于 2026-07-24 23:59（北京时间）弃用，别再用了。
# 现行模型是 deepseek-v4-flash，需先充值（约 1 元/百万输入 token）。
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-你的DeepSeek密钥
# LLM_MODEL_ID=deepseek-v4-flash
